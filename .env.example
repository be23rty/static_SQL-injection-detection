# SecureCode AI — Environment Configuration
# Copy this file to .env or set environment variables in your terminal.

# GROQ API (Required for AI investigation, chat, and repair)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Active model (default: llama-3.3-70b-versatile)
# Options: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768, gemma2-9b-it, deepseek-r1-distill-llama-70b
GROQ_MODEL=llama-3.3-70b-versatile

# GitHub Token (Optional, for private repository analysis)
# GITHUB_TOKEN=your_github_token_here
